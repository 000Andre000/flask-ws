

{% extends "base.html" %}

{% block title %}Home{% endblock %}

{% block content %}
<div class="py-4" style="background-color: rgb(255, 255, 255); min-height: 100vh;">
    <div class="container">
        <div class="row mb-4">
            <div class="col-12 text-center">
                <h1 class="display-4 fw-bold text-primary">Task & Weather Dashboard</h1>
                <p class="lead text-muted">Manage your tasks and check the weather in one place</p>
            </div>
        </div>

        <div class="row g-4">
            <!-- Items Section -->
           <div class="col-md-6">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-primary text-white">
                        <h2 class="h4 mb-0"><i class="bi bi-list-check me-2"></i>Your Tasks</h2>
                    </div>
                    <div class="card-body">
                        <div class="task-list mb-4">
                            {% if items %}
                                <ul class="list-group">
                                    {% for item in items %}
                                    <li class="list-group-item border-start-0 border-end-0 border-top-0 d-flex justify-content-between align-items-center py-3">
                                        <div>
                                            <h5 class="mb-1">{{ item.name }}</h5>
                                            <p class="text-muted mb-0 small">{{ item.description }}</p>
                                        </div>
                                        <div class="actions">
                                            <button class="btn btn-sm btn-outline-primary edit-btn rounded-pill me-1" data-id="{{ item.id }}">
                                                <i class="bi bi-pencil"></i> Edit
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger delete-btn rounded-pill" data-id="{{ item.id }}">
                                                <i class="bi bi-trash"></i> Delete
                                            </button>
                                        </div>
                                    </li>
                                    {% endfor %}
                                </ul>
                            {% else %}
                                <div class="text-center py-4">
                                    <i class="bi bi-inbox text-muted" style="font-size: 2rem;"></i>
                                    <p class="mt-2 text-muted">No tasks yet. Add your first task below!</p>
                                </div>
                            {% endif %}
                        </div>

                        <div class="card bg-light">
                            <div class="card-header" style="background-color:rgb(0, 115, 255); color:white">
                                <h3 class="h5 mb-0">
                                    <span id="formTitle">Add New Task</span>
                                    <button type="button" id="resetForm" class="btn btn-sm btn-link float-end text-decoration-none d-none">
                                        Cancel Edit
                                    </button>
                                </h3>
                            </div>
                            <div class="card-body">
                                <form id="itemForm">
                                    <input type="hidden" id="itemId">
                                    <div class="mb-3">
                                        <label for="name" class="form-label">Task Name</label>
                                        <input type="text" class="form-control" id="name" required placeholder="Enter task name">
                                    </div>
                                    <div class="mb-3">
                                        <label for="description" class="form-label">Description</label>
                                        <textarea class="form-control" id="description" rows="2" placeholder="Enter task details"></textarea>
                                    </div>
                                    <button type="submit" class="btn btn-primary w-100" id="submitBtn">Add Task</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div> 

           <!-- Weather Section -->
            <div class="col-md-6">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-info text-white">
                        <h2 class="h4 mb-0"><i class="bi bi-cloud-sun me-2"></i>Weather Information</h2>
                    </div>
                    <div class="card-body">
                        <form id="weatherForm" class="mb-4">
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0">
                                    <i class="bi bi-geo-alt"></i>
                                </span>
                                <input type="text" class="form-control border-start-0" id="city" placeholder="Enter city name" required>
                                <button class="btn btn-info text-white" type="submit">
                                    <i class="bi bi-search me-1"></i>Check Weather
                                </button>
                            </div>
                        </form>

                        <div id="weatherResult" class="card border-0" style="display: none; background-color:rgba(0, 204, 255, 0.27); border-radius: 0.375rem; border:1px solid  ">
                            <div class="card-body text-center">
                                <div class="weather-icon mb-3">
                                    <i class="bi bi-cloud-sun-fill text-info" style="font-size: 4rem;"></i>
                                </div>
                                <h3 class="card-title h4 mb-3" id="weatherCity"></h3>
                                <div class="row g-3">
                                    <div class="col-6">
                                        <div class="card bg-white h-100">
                                            <div class="card-body py-3">
                                                <div class="text-info"><i class="bi bi-thermometer-half"></i></div>
                                                <h5 class="h2 mb-0" id="weatherTemp"></h5>
                                                <div class="small text-muted">Temperature (°C)</div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="card bg-white h-100">
                                            <div class="card-body py-3">
                                                <div class="text-info"><i class="bi bi-cloud"></i></div>
                                                <h5 class="h5 mb-0" id="weatherDesc"></h5>
                                                <div class="small text-muted">Conditions</div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="card bg-white h-100">
                                            <div class="card-body py-3">
                                                <div class="text-info"><i class="bi bi-droplet"></i></div>
                                                <h5 class="h2 mb-0"><span id="weatherHumidity"></span><small>%</small></h5>
                                                <div class="small text-muted">Humidity</div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="card bg-white h-100">
                                            <div class="card-body py-3">
                                                <div class="text-info"><i class="bi bi-wind"></i></div>
                                                <h5 class="h2 mb-0"><span id="weatherWind"></span><small>km/h</small></h5>
                                                <div class="small text-muted">Wind Speed</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="mt-3">
                                    <p class="text-muted small">Last updated: <span id="weatherTime"></span></p>
                                </div>
                            </div>
                        </div>

                        <div id="weatherPlaceholder" class="text-center py-5 bi-cloud-sun" style="background-color:rgb(255, 255, 255); border-radius: 0.375rem; border:1px solid ">
                            <i class="bi bi-cloud text-info" style="font-size: 3rem;"></i>
                            <p class="mt-3 text-muted">Enter a city name to check the current weather</p>
                        </div>
                    </div>
                </div>
            </div> 
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const itemForm = document.getElementById('itemForm');
    const resetFormBtn = document.getElementById('resetForm');
    const submitBtn = document.getElementById('submitBtn');
    const formTitle = document.getElementById('formTitle');
    
    // Function to reset form
    function resetForm() {
        document.getElementById('itemId').value = '';
        document.getElementById('name').value = '';
        document.getElementById('description').value = '';
        submitBtn.textContent = 'Add Task';
        formTitle.textContent = 'Add New Task';
        resetFormBtn.classList.add('d-none');
    }
    
    // Reset form button handler
    resetFormBtn.addEventListener('click', resetForm);
    
    // Item form handling
    itemForm.addEventListener('submit', function(e) {
        e.preventDefault();
        
        const id = document.getElementById('itemId').value;
        const name = document.getElementById('name').value;
        const description = document.getElementById('description').value;
        
        const method = id ? 'PUT' : 'POST';
        const url = id ? `/items/${id}` : '/items';
        
        // Show loading state
        submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Processing...';
        submitBtn.disabled = true;
        
        fetch(url, {
            method: method,
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                name: name,
                description: description
            })
        })
        .then(response => response.json())
        .then(data => {
            // Show success message (could add a toast here)
            window.location.reload();
        })
        .catch(error => {
            console.error('Error:', error);
            submitBtn.textContent = id ? 'Update Task' : 'Add Task';
            submitBtn.disabled = false;
            alert('An error occurred. Please try again.');
        });
    });

    // Edit button handling
    document.querySelectorAll('.edit-btn').forEach(button => {
        button.addEventListener('click', function() {
            const id = this.getAttribute('data-id');
            
            // Show loading state
            this.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>';
            this.disabled = true;
            
            fetch(`/items/${id}`)
                .then(response => response.json())
                .then(item => {
                    document.getElementById('itemId').value = item.id;
                    document.getElementById('name').value = item.name;
                    document.getElementById('description').value = item.description;
                    submitBtn.textContent = 'Update Task';
                    formTitle.textContent = 'Edit Task';
                    resetFormBtn.classList.remove('d-none');
                    
                    // Scroll to form
                    itemForm.scrollIntoView({ behavior: 'smooth' });
                    
                    // Reset button state
                    this.innerHTML = '<i class="bi bi-pencil"></i> Edit';
                    this.disabled = false;
                })
                .catch(error => {
                    console.error('Error:', error);
                    this.innerHTML = '<i class="bi bi-pencil"></i> Edit';
                    this.disabled = false;
                });
        });
    });

    // Delete button handling
    document.querySelectorAll('.delete-btn').forEach(button => {
        button.addEventListener('click', function() {
            const id = this.getAttribute('data-id');
            
            if (confirm('Are you sure you want to delete this task?')) {
                // Show loading state
                this.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>';
                this.disabled = true;
                
                fetch(`/items/${id}`, {
                    method: 'DELETE'
                })
                .then(response => response.json())
                .then(data => {
                    window.location.reload();
                })
                .catch(error => {
                    console.error('Error:', error);
                    this.innerHTML = '<i class="bi bi-trash"></i> Delete';
                    this.disabled = false;
                });
            }
        });
    });

    // Weather form handling
    const weatherForm = document.getElementById('weatherForm');
    const weatherPlaceholder = document.getElementById('weatherPlaceholder');
    
    weatherForm.addEventListener('submit', function(e) {
        e.preventDefault();
        const city = document.getElementById('city').value;
        const submitButton = this.querySelector('button[type="submit"]');
        
        // Show loading state
        submitButton.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Loading...';
        submitButton.disabled = true;
        
        fetch(`/weather?city=${encodeURIComponent(city)}`)
            .then(response => response.json())
            .then(data => {
                // Reset button state
                submitButton.innerHTML = '<i class="bi bi-search me-1"></i>Check Weather';
                submitButton.disabled = false;
                
                if (data.error) {
                    alert(data.error);
                    return;
                }
                
                document.getElementById('weatherCity').textContent = data.city;
                document.getElementById('weatherTemp').textContent = data.temperature;
                document.getElementById('weatherDesc').textContent = data.description;
                document.getElementById('weatherHumidity').textContent = data.humidity;
                document.getElementById('weatherWind').textContent = data.wind_speed;
                
                // Set current time
                const now = new Date();
                document.getElementById('weatherTime').textContent = now.toLocaleTimeString();
                
                // Show weather result and hide placeholder
                document.getElementById('weatherResult').style.display = 'block';
                weatherPlaceholder.style.display = 'none';
                
                // Update weather icon based on conditions (simple example)
                const weatherIcon = document.querySelector('.weather-icon i');
                const desc = data.description.toLowerCase();
                
                if (desc.includes('rain') || desc.includes('drizzle')) {
                    weatherIcon.className = 'bi bi-cloud-rain-fill text-info';
                } else if (desc.includes('cloud')) {
                    weatherIcon.className = 'bi bi-cloud-fill text-info';
                } else if (desc.includes('clear') || desc.includes('sun')) {
                    weatherIcon.className = 'bi bi-sun-fill text-warning';
                } else if (desc.includes('snow')) {
                    weatherIcon.className = 'bi bi-snow text-info';
                } else if (desc.includes('thunder') || desc.includes('storm')) {
                    weatherIcon.className = 'bi bi-lightning-fill text-warning';
                } else {
                    weatherIcon.className = 'bi bi-cloud-sun-fill text-info';
                }
            })
            .catch(error => {
                console.error('Error:', error);
                submitButton.innerHTML = '<i class="bi bi-search me-1"></i>Check Weather';
                submitButton.disabled = false;
                alert('An error occurred. Please try again.');
            });
    });
});
</script>
{% endblock %}
